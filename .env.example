# PDF Toolbox - variaveis de ambiente (todas opcionais; valores abaixo sao os padroes)
# A aplicacao le apenas variaveis de ambiente (nao carrega .env sozinha).
# Servico Windows: copie para app.env na pasta do app; o deploy.ps1 aplica as linhas no
# servico (HOST/PORT/WORKERS vem dos parametros do deploy.ps1 e sao ignorados aqui).

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
LOG_LEVEL=info

# Limits
MAX_UPLOAD_SIZE_MB=500
MAX_FILES=50
OFFICE_TIMEOUT_SECONDS=180
# Processos paralelos da compressao extrema (nao passe das vCPUs disponiveis)
COMPRESS_MAX_WORKERS=4

# Pasta de dados (padrao: ./uploads). No container: /home/container/uploads
# UPLOADS_DIR=

# Cleanup
# Pastas de operacoes simples (sem atividade) sao removidas apos este tempo
CLEANUP_DELAY_MINUTES=3
CLEANUP_INTERVAL_SECONDS=60
# Sessoes da mesclagem detalhada expiram apos este tempo sem uso
SESSION_IDLE_MINUTES=30
# Tempo maximo que um processamento em andamento protege sua pasta da limpeza
BUSY_TIMEOUT_MINUTES=60

# CORS (comma-separated origins allowed to call the API from another domain;
# leave empty for same-origin only)
CORS_ORIGINS=
